    <select id="getUsageByRange" resultType="long">
        SELECT ROUND(SUM(
        CASE
        WHEN m.dValidInstrInteger IS NULL OR m.dValidInstrInteger = 0
        OR dld.dFapDiff IS NULL OR dld.dFapDiff = 0
        THEN 0
        ELSE dld.dFapDiff / m.dValidInstrInteger
        END
        ), 0) AS usage
        FROM data_lp2_day2 dld
        LEFT JOIN meter_tmp2 m ON dld.mid = m.mid
        WHERE 1 = 1
        <if test="startDate != null and endDate != null">
            AND dld.dtDttm BETWEEN #{startDate} AND #{endDate}
        </if>
    </select>


